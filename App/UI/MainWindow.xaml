<Window x:Class="RelayFleetTracker.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RelayFleetTracker" Height="520" Width="640"
        Closing="MainWindow_OnClosing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="RelayFleetTracker" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- ログイン -->
        <Border Grid.Row="1" Style="{StaticResource RfCard}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="ログイン" Style="{StaticResource RfSectionTitle}"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="LoginDiscordButton" Content="Discordでログイン" Margin="0,0,8,0" Click="LoginDiscordButton_OnClick"/>
                    <Button x:Name="LoginVatsimButton" Content="VATSIMでログイン" Style="{StaticResource RfSecondaryButton}" Margin="0,0,8,0" Click="LoginVatsimButton_OnClick"/>
                    <TextBlock x:Name="LoginStatusText" Style="{StaticResource RfLabel}" Text="未ログイン"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 所属コミュニティ切り替え -->
        <Border Grid.Row="2" Style="{StaticResource RfCard}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="コミュニティ" Style="{StaticResource RfLabel}" Margin="0,0,8,0"/>
                <ComboBox x:Name="CommunityComboBox" Width="240" DisplayMemberPath="Community.Name"
                          SelectionChanged="CommunityComboBox_OnSelectionChanged"/>
            </StackPanel>
        </Border>

        <!-- 機体選択・予約 -->
        <Border Grid.Row="3" Style="{StaticResource RfCard}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="機体" Style="{StaticResource RfLabel}" Margin="0,0,8,0"/>
                <ComboBox x:Name="AircraftComboBox" Width="200" DisplayMemberPath="Registration"/>
                <Button x:Name="ReserveButton" Content="予約する" Margin="8,0,0,0" Click="ReserveButton_OnClick"/>
                <TextBlock x:Name="ReservationStatusText" Style="{StaticResource RfLabel}" Margin="8,0,0,0" Text="予約なし"/>
            </StackPanel>
        </Border>

        <!-- シム接続 -->
        <Border Grid.Row="4" Style="{StaticResource RfCard}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="シム" Style="{StaticResource RfLabel}" Margin="0,0,8,0"/>
                <ComboBox x:Name="SimComboBox" Width="160" SelectedIndex="0">
                    <ComboBoxItem Content="MSFS2020/2024"/>
                    <ComboBoxItem Content="X-Plane12"/>
                    <ComboBoxItem Content="モック（動作確認用）"/>
                </ComboBox>
                <Button x:Name="ConnectSimButton" Content="接続" Margin="8,0,0,0" Click="ConnectSimButton_OnClick"/>
                <TextBlock x:Name="SimStatusText" Style="{StaticResource RfLabel}" Margin="8,0,0,0" Text="未接続"/>
            </StackPanel>
        </Border>

        <!-- フッター: OOOI状態 + 開発者ログ（通常表示からは隠す） -->
        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="OoOiStateText" Text="OOOI状態: idle" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="DeveloperLogButton" Content="開発者ログ" Style="{StaticResource RfLinkButton}" Click="DeveloperLogButton_OnClick"/>
        </Grid>
    </Grid>
</Window>

APP_NAME=RelayFleet
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://relayfleet.example

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=relayfleet
DB_USERNAME=relayfleet
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Xserver共用レンタルサーバー向け変更: 常駐queue:workerが使えないため同期実行にする。
# VerifyPirepJobはPIREP提出リクエストの中でそのまま実行される（VATSIM照合はローカルDB参照のみで軽いため実用上問題ない）。
# VPS/専用サーバーに移行しqueue:workerを常駐させられるようになったらdatabaseに戻すとよい。
QUEUE_CONNECTION=sync
CACHE_STORE=database

# --- Discord ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"
# ネイティブ(Windowsアプリ)からのトークン交換時に許可するredirect_uri(ローカルループバック)
DISCORD_NATIVE_REDIRECT_HOST=127.0.0.1
DISCORD_APPLICATION_PUBLIC_KEY=
# 6.1節: PIREP確定・参加リクエスト通知用のIncoming Webhook URL（暫定でコミュニティ横断の1本、README参照）
DISCORD_WEBHOOK_URL=

# --- VATSIM ---
# 確度: 低〜中。PKCE対応可否・正式なスコープ名は実装開始時にvatsim.dev/services/connect/で必ず再確認すること（設計書10章参照）。
# VATSIM Connectのアプリ申請が承認されるまではfalseのままにする（ログインボタン非表示・ルートも弾く）。
# 承認され次第 true に変更するだけで有効化される。
VATSIM_LOGIN_ENABLED=false
VATSIM_CONNECT_CLIENT_ID=
VATSIM_CONNECT_CLIENT_SECRET=
VATSIM_CONNECT_DOMAIN=https://auth.vatsim.net
VATSIM_CONNECT_REDIRECT_URI="${APP_URL}/auth/vatsim/callback"
VATSIM_DATA_API_URL=https://data.vatsim.net/v3/vatsim-data.json
# 現在は未使用（cronのschedule:run間隔がポーリング間隔を決める。routes/console.php参照）。
# VPS化してSupervisor常駐ループ版に戻す場合のみ意味を持つ設定値として残してある。
VATSIM_POLL_INTERVAL_SECONDS=60

# --- ビジネスルール ---
RESERVATION_DEFAULT_HOURS=12
